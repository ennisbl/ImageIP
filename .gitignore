build/*.zip
build/*.spec
build/.gitignore_build

# Development directories
__dev__/

# Documentation build artifacts (keep source docs)
docs/build/
docs/_build/
docs/.doctrees/

# Legacy build scripts (remove after cleanup)
build_release.py
build_release.bat
quick_build.py

# External build system artifacts  
ImageIP-v*-Test.spec
ImageIP-v*.*.*.spec
.gitignore_build

# Version artifacts
[0-9]*.[0-9]*.[0-9]*
[0-9]*.[0-9]*
[0-9]*

# IDEs
.vscode/
.idea/

# Test images (keep assets/)
assets/images/
*.jpg
*.png
*.pdf
!ImageIP*.*

# JSON files (profiles, config, runtime data)
*.json

# Packaging
packaging/dist/
packaging/build/
packaging/*.zip
packaging/*.exe